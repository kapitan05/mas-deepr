# always
TAVILY_API_KEY=tvly-...
OPENAI_API_KEY=sk-...            # judge (gpt-5-mini) + gpt-4.1 baseline
# frontier comparison
GEMINI_API_KEY=...               # Google AI Studio
DEEPSEEK_API_KEY=...             # platform.deepseek.com
# optional -- turns on the W&B mirror everywhere; omit => JSONL only
WANDB_API_KEY=...
# only for --models qwen3-8b (a local vLLM)
MAS_SLM_BASE_URL=http://localhost:8000/v1
MAS_SLM_API_KEY=EMPTY
MAS_SLM_MODEL=Qwen/Qwen3-8B

SEARXNG_BASE_URL=http://localhost:8080

MAS_CRAWL4AI_MAX_CONCURRENT=1
SEMANTIC_SCHOLAR_API_KEY=

# Cloudflare R2 (S3-compatible object store) -- raw runs/ data archive,
# kept off GitHub and out of W&B's free-tier quota.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mas-deepr
